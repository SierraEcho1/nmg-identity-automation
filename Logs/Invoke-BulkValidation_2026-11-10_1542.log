PS C:\nmg-identity-automation> Import-Module ActiveDirectory

$Domain = Get-ADDomain
if ($Domain.DNSRoot -ne "NMG.com") {
    Write-Host ""
    Write-Host "  STOP. This is not the NMG.com lab domain." -ForegroundColor Red
    Write-Host ""
    return
}

$Root   = $Domain.DistinguishedName
$OuName = "Test Accounts"
$OuPath = "OU=$OuName,$Root"
$Pw     = ConvertTo-SecureString "Northstar2025!" -AsPlainText -Force

Write-Host ""
Write-Host "  THROWAWAY ACCOUNTS FOR DAY 14" -ForegroundColor Cyan
Write-Host "  -----------------------------"
Write-Host ""

#--- Remove any that already exist, wherever they are --------
# A previous run may have moved them to Disabled Users or left
# them half-offboarded. Fresh means fresh.

$old = Get-ADUser -Filter "SamAccountName -like 'testuser*'" -ErrorAction SilentlyContinue
if ($old) {
    $old | Remove-ADUser -Confirm:$false
    Write-Host "        reset   : removed $($old.Count) existing test accounts" -ForegroundColor DarkGray
}

Get-ChildItem "C:\Reports\Offboarding\testuser*" -ErrorAction SilentlyContinue | Remove-Item -Force
Get-ChildItem "C:\Reports\Offboarding\BulkRun_*"  -ErrorAction SilentlyContinue | Remove-Item -Force

#--- The OU they live in -------------------------------------

if (-not (Get-ADOrganizationalUnit -Filter "Name -eq '$OuName'" -ErrorAction SilentlyContinue)) {
    New-ADOrganizationalUnit -Name $OuName -Path $Root -ProtectedFromAccidentalDeletion $false
    Write-Host "        created : OU $OuName" -ForegroundColor Green
}

#--- Two groups, so the rollback has something to restore ----

foreach ($g in @("Test-Users", "Test-Shared")) {
    if (-not (Get-ADGroup -Filter "Name -eq '$g'" -ErrorAction SilentlyContinue)) {
        New-ADGroup -Name $g -GroupScope Global -GroupCategory Security `
            -Path $OuPath -Description "Day 14 throwaway group"
        Write-Host "        created : group $g" -ForegroundColor Green
    }
}

#--- The 11 accounts -----------------------------------------

foreach ($i in 1..11) {
    $sam  = "testuser{0:D2}" -f $i
    $name = "Test User {0:D2}" -f $i

    New-ADUser -Name $name -DisplayName $name -SamAccountName $sam `
        -UserPrincipalName "$sam@NMG.com" -Path $OuPath `
        -Department "Test Accounts" -Title "Throwaway" `
        -AccountPassword $Pw -Enabled $true -ChangePasswordAtLogon $false

    Add-ADGroupMember -Identity "Test-Users"  -Members $sam
    Add-ADGroupMember -Identity "Test-Shared" -Members $sam
}
Write-Host "        created : testuser01 to testuser11, each in 2 groups" -ForegroundColor Green

#--- The list that points at them ----------------------------

$Folder = "C:\Reports\Separations"
if (-not (Test-Path $Folder)) { New-Item -Path $Folder -ItemType Directory -Force | Out-Null }
$File = "$Folder\test-accounts.csv"

1..11 | ForEach-Object {
    [PSCustomObject]@{
        Row      = $_ + 1
        Username = "testuser{0:D2}" -f $_
        Name     = "Test User {0:D2}" -f $_
        LastSeen = (Get-Date).AddDays(-200)
        Verdict  = "READY"
    }
} | Export-Csv $File -NoTypeInformation

Write-Host "        list    : $File"
Write-Host ""
Write-Host "  Fresh. Break anything you like." -ForegroundColor Yellow
Write-Host ""


  THROWAWAY ACCOUNTS FOR DAY 14
  -----------------------------

        created : OU Test Accounts
        created : group Test-Users
        created : group Test-Shared
        created : testuser01 to testuser11, each in 2 groups
        list    : C:\Reports\Separations\test-accounts.csv

  Fresh. Break anything you like.

